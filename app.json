{
  "expo": {
    "name": "WearLog",
    "slug": "wearlog",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wearlog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.wearlog.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.wearlog.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F6F5F2",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png",
      "name": "WearLog",
      "shortName": "WearLog",
      "themeColor": "#1A1A1A",
      "backgroundColor": "#F6F5F2"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5F2",
          "image": "./assets/images/icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#111111",
            "image": "./assets/images/icon.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "주변 날씨를 불러와 오늘의 코디를 추천하는 데만 현재 위치를 사용해요. 위치는 저장하거나 공유하지 않아요.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "옷장에 등록할 옷 사진을 직접 고를 때만 사진에 접근해요.",
          "cameraPermission": "옷장에 등록할 옷을 촬영할 때만 카메라를 사용해요.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
