# Copy to .env.local and fill in. Only PUBLIC client values belong here.
# NEVER put the Supabase service_role key, DB password, Google/Kakao client secrets
# or the KMA (기상청) service key in the app — those live in Supabase secrets only.
# Leave empty to run WearLog fully local (community = "서버 미설정", weather = 수동 선택).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Support contact shown in policy screens (required before any public release)
EXPO_PUBLIC_SUPPORT_EMAIL=
# Person or business named as the privacy officer in the privacy policy (required before public release)
EXPO_PUBLIC_OPERATOR_NAME=
